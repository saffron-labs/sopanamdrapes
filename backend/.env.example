# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Public URL of the site (storefront + API + admin share one origin in production)
APP_ORIGIN=http://localhost:3000
# Extra origins allowed to call the API with cookies (comma separated). Leave empty in production.
ALLOWED_ORIGINS=
# Set to 1 when behind Vercel / a trusted proxy so X-Forwarded-For is used for rate limiting
TRUST_PROXY=0

# ── Database (Supabase Postgres, use the pooled connection string) ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sopanam

# ── Secrets (generate each with: openssl rand -base64 48) ────────────
SESSION_PEPPER=change-me-change-me-change-me-change-me-change-me
# 32 bytes, base64. Encrypts admin TOTP secrets at rest. openssl rand -base64 32
DATA_ENC_KEY=
CRON_SECRET=change-me-change-me-change-me

# ── Razorpay ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OTP / notifications ──────────────────────────────────────────────
# console (dev only: prints the code) | msg91 | whatsapp
OTP_DRIVER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
# Order emails via Resend
RESEND_API_KEY=
MAIL_FROM="Sopanam Drapes <care@sopanamdrapes.com>"

# ── Image storage (Supabase Storage) ─────────────────────────────────
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# ── Admin hardening ──────────────────────────────────────────────────
# Optional comma separated list of IPs allowed to reach /admin
ADMIN_IP_ALLOWLIST=
